# TradingView -> MT5 桥接服务配置
# 复制本文件为 .env 并填写真实值（不要提交到 git）

# FTMO / MT5 账户信息
MT5_LOGIN=12345678
MT5_PASS=你的MT5密码
MT5_SERVER=FTMO-MT5

# Flask 监听配置（默认即可，防火墙需放行对应端口）
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# 账户快照写入频率（秒），Dashboard 资金曲线依赖它
SNAPSHOT_INTERVAL=300

# ---- Webhook 安全校验 ----
# 唯一 TOKEN：TradingView 调用 /webhook 时需携带（body 的 "token" 字段 或 请求头 X-Webhook-Token）。
# 留空则关闭校验（不建议）。请用足够随机的字符串，如：openssl rand -hex 16
WEBHOOK_TOKEN=

# ---- FTMO 1-Step 风控（默认即官方红线，通常无需改）----
# 单日亏损红线：官方默认初始余额的 3%（MDL，每日重置）
FTMO_DAILY_LOSS_PCT=0.03
# 总亏损红线：官方默认初始余额的 10%（ML，EOD Trailing：历史最高日终余额-10%初始）
FTMO_TOTAL_LOSS_PCT=0.10
# 账户初始余额（可留空，首次运行自动从 MT5 记录；填写可确保基线稳定）
FTMO_INITIAL_BALANCE=

# ---- 新闻过滤（Forex Factory 公开经济日历）----
# 总开关
NEWS_FILTER_ENABLED=true
# 日历数据源（Forex Factory 公开 JSON，可换兼容端点）
NEWS_API_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
# 拦截的影响等级（逗号分隔：High/Medium/Low）
NEWS_IMPACT=High,Medium
# 发布前/后 N 分钟内禁止开仓
NEWS_MINUTES_BEFORE=5
NEWS_MINUTES_AFTER=5
# 拦截的币种，留空=全部（可配：USD,EUR,GBP）；未配时按品种自动匹配相关币种
NEWS_COUNTRIES=
# 日历刷新周期（秒）
NEWS_REFRESH_SEC=1800

# ---- 交易时段 / 单日开仓次数（风控增强，只约束开仓，平仓不受限）----
# 总开关
TRADING_ENABLED=true
# 允许开仓的星期（1=周一 .. 7=周日，逗号分隔；默认周一至周五）
TRADING_OPEN_DAYS=1,2,3,4,5
# 允许开仓的 UTC 时间窗口（HH:MM-HH:MM；默认全天。如仅欧盘+美盘：13:00-21:00）
TRADING_OPEN_HOURS=00:00-23:59
# 节假日（UTC 日期，YYYY-MM-DD，逗号分隔），当日禁止开仓
TRADING_HOLIDAYS=
# 单日最大开仓次数（0=不限），按 UTC 日重置
MAX_OPEN_PER_DAY=0

# ---- Dashboard 配置 ----
# Dashboard 监听端口（独立于桥接服务 5000）
DASH_HOST=0.0.0.0
DASH_PORT=8080
# 桥接服务地址（Dashboard 调用 /api/account 与 /webhook）
BRIDGE_URL=http://127.0.0.1:5000
